<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fallback_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/widget_artwork_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_artwork" />

            <LinearLayout
                android:id="@+id/widget_metadata_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:ignore="NestedWeights">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_default_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_default_artist"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_button_ripple"
                    android:contentDescription="@string/widget_action_previous"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_skip_previous" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_button_ripple"
                    android:contentDescription="@string/widget_action_play_pause"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_play" />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_button_ripple"
                    android:contentDescription="@string/widget_action_next"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_skip_next" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_divider_gradient" />

        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/widget_search_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:alpha="0.85"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_search" />

            <TextView
                android:id="@+id/search_bar_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_search_hint"
                android:textColor="#CCFFFFFF"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
