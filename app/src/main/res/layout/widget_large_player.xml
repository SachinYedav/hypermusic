<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fallback_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_artwork_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_default_artwork" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_metadata_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_default_title"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_default_artist"
                android:textColor="#B3FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_repeat"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_ripple"
                android:contentDescription="@string/widget_action_repeat"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_repeat" />

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_ripple"
                android:contentDescription="@string/widget_action_previous"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_skip_previous" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.25"
                android:background="@drawable/widget_button_ripple"
                android:contentDescription="@string/widget_action_play_pause"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_ripple"
                android:contentDescription="@string/widget_action_next"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_skip_next" />

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_ripple"
                android:contentDescription="@string/widget_action_like"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_heart_outline" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
